---
import { translations as t } from "../i18n/translations";

interface SeasonLink {
  id: number;
  name: string;
  label: string;
  href: string;
}

interface Props {
  seasons: SeasonLink[];
  current: number;
}

const { seasons, current } = Astro.props;
---

<nav aria-label={t.seasons}>
  <ul class="flex rounded-panel bg-panel p-0.5">
    {
      seasons.map((season) => {
        const isCurrent = current === season.id;

        return (
          <li>
            <a
              href={season.href}
              aria-current={isCurrent ? "page" : undefined}
              aria-label={season.label}
              title={season.label}
              class:list={[
                "block whitespace-nowrap rounded-md px-3 py-1.5 text-sm font-semibold transition-colors sm:py-1",
                isCurrent ? "bg-ink text-white" : "text-muted hover:text-ink",
              ]}
            >
              {season.name}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
