---
import AdminDialog from "./AdminDialog.astro";
import PeriodTabs from "./PeriodTabs.astro";
import Rules from "./Rules.astro";
import SeasonTabs from "./SeasonTabs.astro";
import Layout from "../layouts/Layout.astro";
import { createDb } from "../db";
import { getSafeRedirectPath, hasValidAdminSession } from "../lib/admin-auth";
import { getLeaderboardState, getPeriods } from "../lib/leaderboard";
import { POINT_CHANGES } from "../lib/points";
import {
  formatSeasonRange,
  getSeasonHref,
  getStartedSeasons,
  resolveSeason,
  type Season,
} from "../lib/seasons";
import { translations as t } from "../i18n/translations";

const now = new Date();
const requestedSeason = Astro.url.searchParams.get("season");
const requestedPeriod = Astro.url.searchParams.get("period");
const season = resolveSeason({ season: requestedSeason, period: requestedPeriod }, now);
const db = createDb(Astro.locals.runtime.env.DB);
const state = await getLeaderboardState(db, { season, period: requestedPeriod, now });
const isAdmin = hasValidAdminSession(Astro.cookies, Astro.locals.runtime.env);
const periods = getPeriods(season, t.months, now).map((period) => ({
  ...period,
  href: getSeasonHref(season, period.value, now),
}));
const seasons = getStartedSeasons(now).map((item) => ({
  id: item.id,
  name: getSeasonName(item),
  shortName: `${t.season.charAt(0)}${item.id}`,
  label: getSeasonLabel(item),
  href: getSeasonHref(item, undefined, now),
}));
const isArchived = state.status === "archived";
const periodLabel = periods.find(({ value }) => value === state.period)?.label;
// Only the latest month of the season in progress accepts points.
const canEdit = isAdmin && state.status === "active" && periods.at(-1)?.value === state.period;
const pageUrl = new URL(Astro.url);
pageUrl.searchParams.delete("admin");
pageUrl.searchParams.delete("error");
const currentPath = getSafeRedirectPath(`${pageUrl.pathname}${pageUrl.search}`);
const adminHref = `${currentPath}${currentPath.includes("?") ? "&" : "?"}admin=1`;
const showDialog = Astro.url.searchParams.get("admin") === "1" && !isAdmin;
const showError = Astro.url.searchParams.get("error") === "invalid";

const points = new Intl.NumberFormat("it", { maximumFractionDigits: 2 });

function formatChange(value: number) {
  return `${value > 0 ? "+" : ""}${points.format(value)}`;
}

function getSeasonName(item: Season) {
  return `${t.season} ${item.id}`;
}

function getSeasonLabel(item: Season) {
  return `${getSeasonName(item)} (${formatSeasonRange(item, t.months)})`;
}
---

<Layout title={isArchived ? `${t.title} · ${getSeasonName(season)}` : t.title}>
  <main class="container mx-auto px-4 py-8">
    <div class="mx-auto max-w-2xl">
      <header>
        <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-2 sm:gap-x-4">
          <h1 class="text-center text-2xl font-bold text-ink sm:text-3xl">{t.title}</h1>
          {seasons.length > 1 && <SeasonTabs seasons={seasons} current={season.id} />}
        </div>
        <PeriodTabs periods={periods} current={state.period} />
      </header>

      <div class="mt-6 overflow-x-auto rounded-panel bg-panel">
        <table class="w-full table-auto sm:table-fixed">
          <caption class="sr-only">
            {[getSeasonLabel(season), periodLabel].filter(Boolean).join(", ")}
          </caption>
          <thead class="bg-ink text-white">
            <tr>
              <th scope="col" class="w-3/5 px-4 py-3 text-left sm:px-6">{t.name}</th>
              <th scope="col" class="w-2/5 px-4 py-3 text-left sm:px-6">{t.ficuzPoints}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {
              state.leaderboard.map((entry, index) => {
                // A season starts with everyone at zero: no podium until someone has points.
                const medal = entry.total > 0 ? ["🥇", "🥈", "🥉"][index] : undefined;

                return (
                  <tr class="hover:bg-panel-muted">
                    <td class="w-3/5 px-4 py-4 font-medium text-action sm:px-6">
                      <div class="flex min-w-0 items-center gap-2 leading-tight">
                        <span class="truncate">{entry.name}</span>
                        {medal && <span aria-hidden="true">{medal}</span>}
                      </div>
                    </td>
                    <td class="relative w-2/5 px-4 py-4 text-body tabular-nums sm:px-6">
                      <div class="relative inline-flex items-center gap-1 whitespace-nowrap">
                        <span>{points.format(entry.total)} {t.unit}</span>
                        {entry.periodPoints !== 0 && (
                          <span class={entry.periodPoints > 0 ? "text-penalty" : "text-relief"}>
                            ({formatChange(entry.periodPoints)})
                          </span>
                        )}
                      </div>

                      {canEdit && (
                        <form
                          method="post"
                          action="/api/points"
                          class="absolute right-1 top-1/2 flex -translate-y-1/2 items-center sm:right-6"
                          aria-label={`${t.adjustPoints}: ${entry.name}`}
                        >
                          <input type="hidden" name="next" value={currentPath} />
                          <input type="hidden" name="season" value={season.id} />
                          <input type="hidden" name="playerId" value={entry.playerId} />
                          {POINT_CHANGES.map((change) => (
                            <button
                              type="submit"
                              name="points"
                              value={change}
                              class:list={[
                                "flex size-9 items-center justify-center rounded-full bg-transparent text-3xl font-light leading-none transition-colors sm:size-10",
                                change < 0
                                  ? "text-relief hover:text-relief-bright"
                                  : "text-penalty hover:text-penalty-bright",
                              ]}
                              aria-label={`${t.pointChangeLabels[change]}: ${entry.name}`}
                              title={t.pointChangeLabels[change]}
                            >
                              {change < 0 ? "−" : "+"}
                            </button>
                          ))}
                        </form>
                      )}
                    </td>
                  </tr>
                );
              })
            }
            {
              state.leaderboard.length === 0 && (
                <tr>
                  <td colspan="2" class="px-4 py-8 text-center text-muted sm:px-6">
                    {t.noPlayers}
                  </td>
                </tr>
              )
            }
          </tbody>
        </table>
      </div>

      <Rules />

      <div class="mt-6 text-center">
        {
          isAdmin ? (
            <form method="post" action="/admin/logout">
              <input type="hidden" name="next" value={currentPath} />
              <button type="submit" class="text-sm font-medium text-muted transition hover:text-ink">
                {t.adminLogout}
              </button>
            </form>
          ) : (
            <a href={adminHref} class="text-sm font-medium text-muted transition hover:text-ink">
              {t.admin}
            </a>
          )
        }
      </div>
    </div>
  </main>

  {showDialog && <AdminDialog closePath={currentPath} showError={showError} />}
</Layout>
