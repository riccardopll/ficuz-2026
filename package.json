{
  "name": "ficuz-2026",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "db:migrate": "drizzle-kit generate && wrangler d1 migrations apply ficuz-2026-db --remote",
    "db:migrate:local": "drizzle-kit generate && wrangler d1 migrations apply ficuz-2026-db",
    "db:snapshot:sql": "tsx scripts/season-snapshot-sql.ts",
    "db:studio": "drizzle-kit studio",
    "db:studio:local": "drizzle-kit studio --config drizzle.config.local.ts",
    "deploy": "npx astro build && npx wrangler deploy",
    "dev": "npx astro dev",
    "fix": "oxfmt && oxlint --fix && astro check",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.12",
    "@tailwindcss/vite": "^4.1.18",
    "astro": "^5.16.11",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.1",
    "drizzle-kit": "^0.31.8",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "wrangler": "^4.59.2"
  }
}
